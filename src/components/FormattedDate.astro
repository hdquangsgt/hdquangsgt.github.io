---
import { langFromUrl, LOCALE_META } from '../i18n';

export interface Props {
  date: Date;
}

const { date } = Astro.props;
// Dates in frontmatter are calendar dates, so format in UTC to avoid off-by-one days.
const label = date.toLocaleDateString(LOCALE_META[langFromUrl(Astro.url)].dateLocale, {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<time datetime={date.toISOString()}>{label}</time>
