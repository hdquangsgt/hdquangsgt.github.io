---
import { SITE, SOCIAL_LINKS } from '../consts';
import { langFromUrl, localizePath, useTranslations } from '../i18n';

const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <p>© {year} {SITE.author}</p>
    <ul class="footer-links">
      {
        SOCIAL_LINKS.map((link) => (
          <li>
            <a href={link.href} rel="me">{link.label}</a>
          </li>
        ))
      }
      <li><a href={localizePath(lang, '/rss.xml')}>{t.nav.rss}</a></li>
      <li><a href="/sitemap-index.xml">{t.footer.sitemap}</a></li>
    </ul>
  </div>
</footer>
