---
import { PREFERENCE_OPTIONS } from '../utils/preferences';
import { langFromUrl, useTranslations } from '../i18n';

const t = useTranslations(langFromUrl(Astro.url)).readingSettings;

// Radio groups come from one table, so adding an option later is one line there, one label in
// i18n.ts, and one rule in global.css. `default` is the value used when the attribute is absent.
const groups = [
  { name: 'theme', legend: t.theme, labels: t.themes },
  { name: 'font', legend: t.font, labels: t.fonts },
  { name: 'size', legend: t.size, labels: t.sizes },
] as const;
---

<!-- Hidden until the script runs: without JavaScript the preferences could not be applied. -->
<div class="reading-settings" data-reading-settings hidden>
  <button type="button" class="settings-button" popovertarget="reading-settings-panel" aria-label={t.open}>
    <!-- Settings (gear) icon, Feather (MIT). Drawn with currentColor so it follows the theme. -->
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="3"></circle>
      <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
    </svg>
  </button>
  <div id="reading-settings-panel" class="settings-panel" popover role="group" aria-label={t.title}>
    {
      groups.map((group) => (
        <fieldset class="settings-group" data-pref={group.name}>
          <legend>{group.legend}</legend>
          <div class="segmented">
            {PREFERENCE_OPTIONS[group.name].values.map((value) => (
              <label data-size-option={group.name === 'size' ? value : undefined}>
                <input type="radio" name={`pref-${group.name}`} value={value} />
                <span>{(group.labels as Record<string, string>)[value]}</span>
              </label>
            ))}
          </div>
        </fieldset>
      ))
    }
    <button type="button" class="settings-reset" data-reset>{t.reset}</button>
  </div>
</div>

<script>
  import { PREFERENCE_OPTIONS, PREFERENCES_KEY, applyPreferences, readPreferences, type PreferenceName } from '../utils/preferences';

  const root = document.querySelector<HTMLElement>('[data-reading-settings]');
  const panel = root?.querySelector<HTMLElement>('#reading-settings-panel');
  const button = root?.querySelector<HTMLButtonElement>('.settings-button');

  // The Popover API gives light-dismiss, Escape and focus return for free. Without it, leave the control out.
  if (root && panel && button && 'showPopover' in panel) {
    root.hidden = false;
    const names = Object.keys(PREFERENCE_OPTIONS) as PreferenceName[];

    const syncRadios = () => {
      const current = readPreferences(document.documentElement);
      for (const name of names) {
        for (const input of root.querySelectorAll<HTMLInputElement>(`input[name="pref-${name}"]`)) {
          input.checked = input.value === current[name];
        }
      }
    };

    const save = () => {
      const prefs: Record<string, string> = {};
      for (const name of names) {
        const checked = root.querySelector<HTMLInputElement>(`input[name="pref-${name}"]:checked`);
        if (checked) prefs[name] = checked.value;
      }
      applyPreferences(document.documentElement, prefs);
      try {
        localStorage.setItem(PREFERENCES_KEY, JSON.stringify(prefs));
      } catch {
        // Storage can be blocked (private mode, site data off). The choice still applies to this page.
      }
    };

    root.addEventListener('change', save);
    root.querySelector('[data-reset]')?.addEventListener('click', () => {
      try {
        localStorage.removeItem(PREFERENCES_KEY);
      } catch {
        // ignore
      }
      applyPreferences(document.documentElement, {});
      syncRadios();
    });

    // Place the panel under the button; it is fixed, so it does not depend on the header's layout.
    panel.addEventListener('beforetoggle', (event) => {
      if ((event as ToggleEvent).newState !== 'open') return;
      const rect = button.getBoundingClientRect();
      panel.style.top = `${Math.round(rect.bottom + 8)}px`;
      panel.style.right = `${Math.max(8, Math.round(window.innerWidth - rect.right))}px`;
      syncRadios();
    });

    // Another tab changed the preferences: follow it.
    window.addEventListener('storage', (event) => {
      if (event.key !== PREFERENCES_KEY && event.key !== null) return;
      try {
        applyPreferences(document.documentElement, JSON.parse(event.newValue ?? '{}'));
      } catch {
        applyPreferences(document.documentElement, {});
      }
      syncRadios();
    });

    syncRadios();
  }
</script>
