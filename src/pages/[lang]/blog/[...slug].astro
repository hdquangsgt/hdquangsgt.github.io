---
import ArticleView from '../../../views/ArticleView.astro';
import SlideView from '../../../views/SlideView.astro';
import { prefixed } from '../../../utils/paths';

export const getStaticPaths = prefixed.articlePaths;

type Props = import('../../../views/ArticleView.astro').Props;
// Slide articles (`slides: true`) get their own layout; see views/SlideView.astro.
const View = Astro.props.post.data.slides && !Astro.props.standard ? SlideView : ArticleView;
---

<View {...Astro.props} />
